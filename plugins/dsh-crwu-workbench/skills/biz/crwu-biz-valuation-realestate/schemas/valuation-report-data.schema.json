{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "crwu.valuation.report-data.v2",
  "title": "房地产估值报告数据（估值报告数据.json，约束 HTML 的唯一数据源）",
  "description": "判别联合。HTML 只能由这份数据渲染，模型不能直接写 HTML / 样式 / 片段。blocked 的报告没有金额也没有工作簿；completed 必须有对象结论、计算表、知识引用与 finalize 校验回执（设计稿 §11.3 / §11.4）。",
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "#/definitions/base"
        }
      ],
      "type": "object",
      "required": [
        "schemaVersion",
        "projectId",
        "planId",
        "generatedAt",
        "methodRequest",
        "method",
        "baseDate",
        "baseDateSpecified",
        "purpose",
        "purposeSpecified",
        "valueType",
        "valueTypeSpecified",
        "supplementalPrompt",
        "inputDigest",
        "materials",
        "knowledgeSources",
        "retrievalAttempts",
        "artifacts",
        "limitations",
        "status",
        "objects",
        "methodAssessment",
        "parameters",
        "comparables",
        "calculationSteps",
        "ruleChecks",
        "conclusions",
        "evidence",
        "workbooks",
        "validation"
      ],
      "properties": {
        "status": {
          "const": "completed"
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/valuationObject"
          }
        },
        "methodAssessment": {
          "$ref": "#/definitions/planAssessment"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/parameter"
          }
        },
        "comparables": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/comparable"
          }
        },
        "calculationSteps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/calculationStep"
          }
        },
        "ruleChecks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ruleCheck"
          }
        },
        "conclusions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/conclusion"
          },
          "description": "每个对象一条；不得用一条汇总金额代表多个对象"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/screenshot"
          }
        },
        "workbooks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/workbook"
          },
          "description": "多对象时允许是对象级工作簿集合"
        },
        "validation": {
          "$ref": "#/definitions/validation"
        }
      }
    },
    {
      "allOf": [
        {
          "$ref": "#/definitions/base"
        }
      ],
      "type": "object",
      "required": [
        "schemaVersion",
        "projectId",
        "planId",
        "generatedAt",
        "methodRequest",
        "method",
        "baseDate",
        "baseDateSpecified",
        "purpose",
        "purposeSpecified",
        "valueType",
        "valueTypeSpecified",
        "supplementalPrompt",
        "inputDigest",
        "materials",
        "knowledgeSources",
        "retrievalAttempts",
        "artifacts",
        "limitations",
        "status",
        "stage",
        "blockers",
        "lookupAttempts",
        "conclusion",
        "partialObjectResults"
      ],
      "properties": {
        "status": {
          "const": "blocked"
        },
        "stage": {
          "enum": [
            "intake",
            "extract",
            "grouping",
            "knowledge",
            "method-selection",
            "retrieval",
            "parameters",
            "template",
            "calculation",
            "delivery"
          ]
        },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/blocker"
          },
          "description": "必须列全：缺什么、查过哪、为什么、怎么补"
        },
        "lookupAttempts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/lookupAttempt"
          },
          "description": "精确路径 → 同目录同名 → 别名 → 身份已验证镜像 的完整查找轨迹"
        },
        "conclusion": {
          "const": null
        },
        "partialObjectResults": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/objectResult"
          },
          "description": "阻断前的过程材料，不是结论"
        }
      }
    },
    {
      "allOf": [
        {
          "$ref": "#/definitions/base"
        }
      ],
      "type": "object",
      "required": [
        "schemaVersion",
        "projectId",
        "planId",
        "generatedAt",
        "methodRequest",
        "method",
        "baseDate",
        "baseDateSpecified",
        "purpose",
        "purposeSpecified",
        "valueType",
        "valueTypeSpecified",
        "supplementalPrompt",
        "inputDigest",
        "materials",
        "knowledgeSources",
        "retrievalAttempts",
        "artifacts",
        "limitations",
        "status",
        "stage",
        "completedWork",
        "outstanding",
        "blockers",
        "lookupAttempts",
        "provisionalResults",
        "conclusion"
      ],
      "properties": {
        "status": {
          "const": "partial"
        },
        "stage": {
          "enum": [
            "intake",
            "extract",
            "grouping",
            "knowledge",
            "method-selection",
            "retrieval",
            "parameters",
            "template",
            "calculation",
            "delivery"
          ]
        },
        "completedWork": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "outstanding": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/blocker"
          }
        },
        "lookupAttempts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/lookupAttempt"
          }
        },
        "provisionalResults": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/provisionalObjectResult"
          },
          "description": "暂算金额，不得作为最终结论展示；未确认的价值范围必须保持 null，不得默认房地合一"
        },
        "conclusion": {
          "const": null
        }
      }
    },
    {
      "allOf": [
        {
          "$ref": "#/definitions/base"
        }
      ],
      "type": "object",
      "required": [
        "schemaVersion",
        "projectId",
        "planId",
        "generatedAt",
        "methodRequest",
        "method",
        "baseDate",
        "baseDateSpecified",
        "purpose",
        "purposeSpecified",
        "valueType",
        "valueTypeSpecified",
        "supplementalPrompt",
        "inputDigest",
        "materials",
        "knowledgeSources",
        "retrievalAttempts",
        "artifacts",
        "limitations",
        "status",
        "stage",
        "error",
        "blockers",
        "conclusion",
        "availableArtifacts"
      ],
      "properties": {
        "status": {
          "const": "failed"
        },
        "stage": {
          "enum": [
            "intake",
            "extract",
            "grouping",
            "knowledge",
            "method-selection",
            "retrieval",
            "parameters",
            "template",
            "calculation",
            "delivery"
          ]
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/blocker"
          }
        },
        "conclusion": {
          "const": null
        },
        "availableArtifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    {
      "allOf": [
        {
          "$ref": "#/definitions/base"
        }
      ],
      "type": "object",
      "required": [
        "schemaVersion",
        "projectId",
        "planId",
        "generatedAt",
        "methodRequest",
        "method",
        "baseDate",
        "baseDateSpecified",
        "purpose",
        "purposeSpecified",
        "valueType",
        "valueTypeSpecified",
        "supplementalPrompt",
        "inputDigest",
        "materials",
        "knowledgeSources",
        "retrievalAttempts",
        "artifacts",
        "limitations",
        "status",
        "stage",
        "error",
        "blockers",
        "conclusion",
        "availableArtifacts"
      ],
      "properties": {
        "status": {
          "const": "cancelled"
        },
        "stage": {
          "enum": [
            "intake",
            "extract",
            "grouping",
            "knowledge",
            "method-selection",
            "retrieval",
            "parameters",
            "template",
            "calculation",
            "delivery"
          ]
        },
        "error": {
          "type": "string"
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/blocker"
          }
        },
        "conclusion": {
          "const": null
        },
        "availableArtifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  ],
  "definitions": {
    "referenceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "aggregation",
        "basis",
        "priceNature",
        "unitPriceUnit",
        "caseIds"
      ],
      "properties": {
        "label": {
          "const": "挂牌参考估值"
        },
        "aggregation": {
          "const": "arithmetic-mean"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "priceNature": {
          "const": "挂牌"
        },
        "unitPriceUnit": {
          "const": "CNY/m2"
        },
        "caseIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "caseId",
              "sourceUrl"
            ],
            "properties": {
              "caseId": {
                "type": "string",
                "minLength": 1
              },
              "sourceUrl": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "knowledgeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeId",
        "snapshotDigest"
      ],
      "properties": {
        "routeId": {
          "type": "string",
          "minLength": 1
        },
        "snapshotDigest": {
          "type": "string",
          "minLength": 1
        },
        "sectionId": {
          "type": "string"
        },
        "ruleId": {
          "type": "string"
        }
      }
    },
    "lookupAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeId",
        "channel",
        "target",
        "outcome",
        "detail"
      ],
      "properties": {
        "routeId": {
          "type": "string"
        },
        "channel": {
          "enum": [
            "exact-route",
            "same-name",
            "alias",
            "mirror",
            "dws-tree"
          ]
        },
        "target": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "found",
            "missing",
            "empty",
            "ambiguous",
            "unreadable",
            "rejected-identity",
            "rejected-digest"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "stage",
        "missing",
        "checked",
        "reason",
        "remediation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "input-invalid",
            "property-unsupported",
            "method-unsupported",
            "valuation-path-unsupported",
            "valuation-path-unresolved",
            "capability-missing",
            "knowledge-missing",
            "template-missing",
            "evidence-missing",
            "recalculation-unavailable"
          ]
        },
        "stage": {
          "enum": [
            "intake",
            "extract",
            "grouping",
            "knowledge",
            "method-selection",
            "retrieval",
            "parameters",
            "template",
            "calculation",
            "delivery"
          ]
        },
        "missing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checked": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string"
        },
        "capabilityId": {
          "type": "string"
        },
        "knowledgeRef": {
          "$ref": "#/definitions/knowledgeRef"
        }
      }
    },
    "knowledgeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeId",
        "nodeName",
        "resolvedPath",
        "source",
        "spaceName",
        "updatedAt",
        "digest",
        "snapshotFile"
      ],
      "properties": {
        "routeId": {
          "type": "string",
          "minLength": 1
        },
        "nodeName": {
          "type": "string",
          "minLength": 1
        },
        "resolvedPath": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "dws",
            "verified-mirror"
          ]
        },
        "spaceName": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "snapshotFile": {
          "type": "string",
          "minLength": 1
        },
        "sectionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workflowKnowledgeRef": {
      "type": "object",
      "additionalProperties": false,
      "description": "已验证工作流快照引用（crwu.valuation.knowledge-ref.v1）：只有真实的 sourceId / 路径 / 指纹 / 正文；未知的库/更新时间/快照文件一律缺席，不得编造。",
      "required": [
        "format",
        "sourceId",
        "path",
        "digest",
        "body"
      ],
      "properties": {
        "format": {
          "const": "crwu.valuation.knowledge-ref.v1"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "spaceName": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retrievalAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "caseId",
        "providerId",
        "stage",
        "outcome",
        "finalUrl",
        "reasonCode"
      ],
      "properties": {
        "taskId": {
          "type": "string"
        },
        "caseId": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        },
        "stage": {
          "enum": [
            "search",
            "detail",
            "screenshot"
          ]
        },
        "outcome": {
          "enum": [
            "ok",
            "blocked",
            "challenge-recovered",
            "waiting-user",
            "unsupported",
            "failed"
          ]
        },
        "finalUrl": {
          "type": "string"
        },
        "reasonCode": {
          "type": "string"
        },
        "recoveryStrategy": {
          "type": "string"
        },
        "recoveryAttempts": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileId",
        "fileName",
        "archiveRelativePath",
        "kind",
        "sizeBytes",
        "sha256",
        "readable"
      ],
      "properties": {
        "fileId": {
          "type": "string",
          "minLength": 1
        },
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "archiveRelativePath": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "modifiedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "readable": {
          "type": "boolean"
        },
        "duplicateOf": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "kind",
        "relativePath",
        "digest",
        "present"
      ],
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "html",
            "workbook",
            "data",
            "screenshot"
          ]
        },
        "relativePath": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "present": {
          "type": "boolean"
        }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "displayName",
        "provider",
        "sourceUrl",
        "capturedAt",
        "relativePath",
        "digest",
        "validity"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "capturedAt": {
          "type": "string"
        },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "description": "必须落在本方案 推理结果/图片/<安全caseId-名称>/ 下；挑战页截图不得进入此目录。"
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "validity": {
          "enum": [
            "valid",
            "missing",
            "invalid",
            "not-required"
          ]
        },
        "evidenceType": {
          "enum": [
            "page-screenshot",
            "detail-screenshot",
            "alternative-evidence"
          ],
          "description": "Optional: distinguishes a list-page screenshot from a real detail screenshot."
        }
      }
    },
    "objectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectId",
        "displayName",
        "valueScope",
        "currency"
      ],
      "properties": {
        "objectId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "valueScope": {
          "enum": [
            "land-only",
            "building-only",
            "land-and-building"
          ]
        },
        "method": {
          "enum": [
            "market",
            "income",
            "cost",
            null
          ]
        },
        "unitPrice": {
          "type": [
            "string",
            "null"
          ]
        },
        "totalValue": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "calculationRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provisionalObjectResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "partial 分支专用：与 objectResult 相同的金额/结果口径，但价值范围允许为 null（未确认时不得默认房地合一）。",
      "required": [
        "objectId",
        "displayName",
        "valueScope",
        "currency"
      ],
      "properties": {
        "objectId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "valueScope": {
          "enum": [
            "land-only",
            "building-only",
            "land-and-building",
            null
          ]
        },
        "method": {
          "enum": [
            "market",
            "income",
            "cost",
            null
          ]
        },
        "unitPrice": {
          "type": [
            "string",
            "null"
          ]
        },
        "totalValue": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "calculationRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "valuationObject": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "objectId",
        "displayName",
        "propertyType",
        "sourceRefs"
      ],
      "properties": {
        "objectId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "propertyType": {
          "oneOf": [
            {
              "enum": [
                "residential",
                "commercial",
                "office",
                "industrial",
                "apartment",
                "other"
              ]
            },
            {
              "const": ""
            }
          ],
          "description": "业务分类；空串 = 未判定（依据缺失时该对象被挂起，不进结论）"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
