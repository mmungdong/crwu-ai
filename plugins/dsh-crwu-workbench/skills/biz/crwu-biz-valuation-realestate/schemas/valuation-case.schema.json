{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "crwu.valuation.case.v1",
  "title": "房地产估值外部案例（估值案例.json 的一条）",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "building_area",
    "built_year",
    "captured_at",
    "community",
    "contact",
    "decoration",
    "drop_reason",
    "evidence",
    "evidence_missing",
    "floor",
    "keep_reason",
    "price",
    "property_nature",
    "published_at",
    "purpose",
    "rule_checks",
    "screenshot",
    "screenshot_captured_at",
    "screenshot_digest",
    "screenshot_missing",
    "source",
    "status",
    "title",
    "total_floors",
    "transaction_type",
    "unit_price",
    "url"
  ],
  "properties": {
    "source": {
      "enum": [
        "fang",
        "anjuke",
        "lianjia"
      ]
    },
    "source_label": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "description": "完整链接（可追溯）"
    },
    "title": {
      "type": "string"
    },
    "community": {
      "type": "string",
      "description": "小区 / 地址"
    },
    "purpose": {
      "type": "string"
    },
    "property_nature": {
      "type": "string"
    },
    "building_area": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "建筑面积（㎡）；拿不到是 null，不许填 0"
    },
    "floor": {
      "type": "string"
    },
    "total_floors": {
      "type": "string"
    },
    "built_year": {
      "type": "string"
    },
    "decoration": {
      "type": "string"
    },
    "price": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "unit_price": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "transaction_type": {
      "enum": [
        "挂牌",
        "成交",
        "询价",
        "未知"
      ],
      "description": "**只有**页面明写「成交」时才是成交；缺省未知。挂牌价是卖方要价，不得直接当成交价"
    },
    "used_as_comparable": {
      "type": "boolean",
      "description": "是否**直接**用作市场法可比实例。只有 `transaction_type=成交` 才允许为 true"
    },
    "published_at": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "minLength": 1,
      "description": "抓取时刻（ISO）"
    },
    "evidence": {
      "type": "string"
    },
    "keep_reason": {
      "type": "string",
      "description": "保留理由；与 drop_reason 至少一个非空（要留下人工判断）"
    },
    "drop_reason": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_missing": {
      "type": "boolean"
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "description": "页面**合法公开展示**的业务联系人 / 机构及联系方式。必须显式给出 state（拿不到也要说明是哪种拿不到），号码按页面原样保留、不许猜补，也不得自动联系。",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "public",
            "not-published",
            "masked",
            "login-required",
            "failed"
          ],
          "description": "public=已公开获取；not-published=页面未公开；masked=页面本身脱敏展示；login-required=需要登录才能看到；failed=获取失败"
        },
        "agency": {
          "type": "string",
          "description": "机构名（公开才有）"
        },
        "person": {
          "type": "string",
          "description": "业务联系人称呼（公开才有）"
        },
        "phone": {
          "type": "string",
          "description": "**原样保留**页面展示的号码，含脱敏形态（如 138****1234）；空串=没拿到"
        },
        "source": {
          "type": "string",
          "description": "这段信息在页面上的位置（如「经纪人卡片」）"
        },
        "captured_at": {
          "type": "string",
          "description": "取得时刻；state=public 时必填"
        },
        "detail": {
          "type": "string",
          "description": "state 为 login-required / failed 时的人话原因"
        }
      }
    },
    "status": {
      "enum": [
        "adopted",
        "not-comparable",
        "insufficient-evidence",
        "single-rule-failed",
        "combined-rule-failed",
        "group-consistency-failed"
      ],
      "description": "案例状态（§8）：采用 / 条件不匹配 / 资料或证据不足 / 单项规则未通过 / 综合规则未通过 / 组内一致性未通过。`adopted` 与 `used_as_comparable=true` 必须一致。"
    },
    "rule_checks": {
      "type": "array",
      "description": "这条案例的规则检查记录（§8）：每个剔除案例至少要有一条 fail，且写明规则 ID、实际值、阈值与理由 —— 只写一句「符合要求」是不可复核的。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "verdict",
          "reason"
        ],
        "properties": {
          "rule_id": {
            "enum": [
              "R-COMPARABILITY",
              "R-EVIDENCE",
              "R-SINGLE-20",
              "R-COMBINED-30",
              "R-GROUP-1.2"
            ]
          },
          "actual": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "实际值（幅度用小数：0.21 表示 21%；比值用倍数）"
          },
          "threshold": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "阈值。数值型规则（R-SINGLE-20 / R-COMBINED-30 / R-GROUP-1.2）必须逐字等于知识库口径 0.2 / 0.3 / 1.2，不许自行放宽"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "not-applicable"
            ]
          },
          "reason": {
            "type": "string",
            "description": "为什么（人工判断必须留痕）"
          }
        }
      }
    },
    "screenshot": {
      "type": "string",
      "description": "页面截图（相对案例目录）；没有截图能力或截图失败时为空串。HTML 字节 / 页面指纹 / JSON-LD **不是截图**，不能填在这里。"
    },
    "screenshot_digest": {
      "type": "string",
      "description": "截图指纹 sha256:<hex>；没有时为空串"
    },
    "screenshot_captured_at": {
      "type": "string",
      "description": "截图采集时刻（ISO）；没有时为空串"
    },
    "screenshot_missing": {
      "type": "boolean",
      "description": "显式标记「这条案例没有截图」。与 evidence_missing 同一条纪律：空串分不出「没截」与「忘了赋值」，而采用案例缺截图时不得标记完成。"
    }
  }
}
