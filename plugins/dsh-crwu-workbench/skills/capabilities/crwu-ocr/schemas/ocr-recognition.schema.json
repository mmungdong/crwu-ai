{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crwu.local/schemas/ocr-recognition.v1.json",
  "title": "crwu-ocr recognition record",
  "type": "object",
  "required": ["sourceId", "pages"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceId": { "type": "string" },
    "relativePath": { "type": "string" },
    "updatedAt": { "type": "string" },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "status"],
        "additionalProperties": true,
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["recognized", "partial", "unreadable"] },
          "imageSha256": { "type": "string" },
          "orientation": { "enum": ["normal", "rotated-90", "rotated-180", "rotated-270", "unknown"] },
          "text": { "type": "string" },
          "tables": { "type": "array" },
          "visibleElements": { "type": "array" },
          "uncertainties": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" },
          "inputPath": { "type": "string" },
          "recordedAt": { "type": "string" },
          "keyValues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "value", "quote"],
              "properties": {
                "label": { "type": "string" },
                "value": { "type": "string" },
                "quote": { "type": "string" }
              }
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "values": { "type": "array", "items": { "type": ["string", "null"] } },
                "reads": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
              }
            }
          },
          "reads": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["n", "status"],
              "properties": {
                "n": { "type": "integer", "minimum": 1 },
                "renderN": { "type": "integer", "minimum": 1 },
                "status": { "enum": ["recognized", "partial", "unreadable"] },
                "recordedAt": { "type": "string" }
              }
            }
          },
          "recognizer": { "type": "string" },
          "recognitionStatus": { "enum": ["recognized", "partial", "unreadable", "conflict"] }
        }
      }
    }
  }
}
