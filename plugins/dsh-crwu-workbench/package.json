{
  "name": "dsh-crwu-workbench",
  "version": "0.0.14",
  "description": "中瑞世联工作台 / CRWU audit workbench for DeepSeek Harness: pick a pending audit report, dispatch one AI audit subagent, watch and stop/restart it, auto-upload deliverables to Aliyun OSS.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "cordis",
    "plugin",
    "audit",
    "workbench",
    "crwu"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmungdong/crwu-ai.git",
    "directory": "plugins/dsh-crwu-workbench"
  },
  "bugs": {
    "url": "https://github.com/mmungdong/crwu-ai/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "scripts/prepare.mjs",
    "config/crwu-workbench.yml",
    "cordis.patch.yml",
    "bin/",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "skills/README.md",
    "skills/crwu/",
    "skills/dws/",
    "common/skills/"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.1.7-rc.2 || ^0.2.0-rc.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "npm run skills:sync && tsdown",
    "build:lib": "node scripts/prepare.mjs --force",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "npm run config:check && npm run skills:sync && npm run dws:check && npm run build:lib",
    "test": "node --test \"tests/*.test.mjs\" \"tests/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "version:check": "node scripts/sync-version.mjs --check",
    "version:set": "node scripts/sync-version.mjs",
    "check": "npm run version:check && npm run config:check && npm run skills:check && npm run skills:cli-guard && npm run dws:check && npm run typecheck && npm test && npm run build && npm run smoke:built",
    "config:check": "node scripts/check-config.mjs",
    "pack:assert": "node scripts/assert-pack.mjs",
    "pack:assert:strict": "node scripts/assert-pack.mjs --strict",
    "prepublishOnly": "npm run check && npm run pack:assert:strict",
    "smoke:built": "node scripts/smoke-built.mjs",
    "skills:sync": "node scripts/sync-common-skills.mjs",
    "skills:check": "node scripts/sync-common-skills.mjs --check",
    "skills:cli-guard": "node scripts/check-skill-cli-guard.mjs",
    "bin:check": "node scripts/sync-binaries.mjs --check",
    "dws:sync": "node scripts/sync-dws-skills.mjs",
    "dws:check": "node scripts/sync-dws-skills.mjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-plugin-manager": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-plugin-manager": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-shell": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/semver": "^7.8.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
